# === Required for any real deployment ===
BIZPILOT_PROD=1
BIZPILOT_PROXY=1

# Long random string used for session cookies (generate once and keep secret)
BIZPILOT_SECRET=change-me-to-a-long-random-string-at-least-40-chars

# Master encryption key (32 random bytes, base64url). Generate with:
#   python -c "from security import encode_key; import secrets; print(encode_key(secrets.token_bytes(32)))"
# BACK THIS UP. Losing it means encrypted records can never be read again.
BIZPILOT_MASTER_KEY=

# Initial owner admin password (min 12 characters). Set this before first deploy.
BIZPILOT_ADMIN_PASSWORD=choose-a-strong-password-here

# === Optional ===
# BIZPILOT_DATA=/var/data          # path to persistent disk (recommended for real use)
# BIZPILOT_TRIAL_DAYS=14
# BIZPILOT_LICENSE_PUBLIC_KEY=/path/to/license_public.pem
